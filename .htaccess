<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. ป้องกันไฟล์ความปลอดภัยสูง ไม่ให้ใครดาวน์โหลดหรือเปิดดูได้เด็ดขาด
    <FilesMatch "(^\.env|\.git|composer\.(json|lock)|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # 2. ป้องกันการเข้าถึงโฟลเดอร์ระบบภายในโดยตรง
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 5. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 5.5 Ensure PowerShell & Batch Agent scripts route through Laravel front controller for dynamic server URL injection
    RewriteRule ^agent/.*\.(ps1|bat)$ index.php [L]

    # 6. ส่งคำขอทั้งหมดเข้าสู่ index.php หากไม่ใช่ไฟล์จริง
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Ensure PowerShell scripts and shell files are served as UTF-8 plaintext
AddType "text/plain; charset=utf-8" .ps1
AddType "text/plain; charset=utf-8" .bat
AddType "text/plain; charset=utf-8" .sh

<IfModule mod_headers.c>
    <FilesMatch "\.(ps1|bat|sh|json)$">
        Header set Content-Type "text/plain; charset=utf-8"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>