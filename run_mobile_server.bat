@echo off
chcp 65001 >nul
title THC IT Service Platform - Mobile & LAN Server
color 0A

echo =======================================================================
echo    โรงพยาบาลทุ่งหัวช้าง - กลุ่มงานสุขภาพดิจิทัล (Digital Health IT)
echo    เซิร์ฟเวอร์สำหรับทดสอบและเข้าใช้งานผ่านอุปกรณ์มือถือและเครือข่าย LAN
echo =======================================================================
echo.
echo [1] IP Address ของเครื่องนี้บนเครือข่าย:
for /f "tokens=4" %%a in ('route print ^| findstr 0.0.0.0.*0.0.0.0 ^| findstr /v "127.0.0.1"') do (
    echo     ==^> %%a
)
echo.
echo [2] URL สำหรับเปิดบนมือถือ (เชื่อมต่อ Wi-Fi เดียวกัน):
echo     ==^> http://192.168.2.89:8000
echo.
echo [3] กำลังเริ่มทำงานเซิร์ฟเวอร์บน 0.0.0.0:8000 ...
echo     (กด Ctrl+C เพื่อหยุดการทำงาน)
echo =======================================================================
echo.

php artisan serve --host=0.0.0.0 --port=8000
pause
